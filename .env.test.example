# Test Environment Configuration
# Copy this to .env.test and fill in with your LOCAL test database credentials.
# NEVER commit .env.test with real credentials.

# Test database - MUST be a dedicated test database, not development/production
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_test_password
DB_NAME=appliances_lk_test

# Required: Must be set to 'test' for safety guards
NODE_ENV=test

# Session configuration for tests
SESSION_TTL_SECONDS=86400

# Frontend URL for CORS/CSRF testing
FRONTEND_URL=http://localhost:5173

# Email - tests use mocks, but config must be present
EMAIL_PROVIDER=gmail
EMAIL_USER=test@example.com
EMAIL_APP_PASSWORD=not_real
EMAIL_FROM_NAME=Appliances.lk Test
EMAIL_FROM_ADDRESS=test@example.com

# External services - tests use mocks
GEMINI_API_KEY=test_key_not_real
GEMINI_MODEL=gemini-3.5-flash-lite

# PayHere - tests use mocks
PAYHERE_MERCHANT_ID=test_merchant
PAYHERE_MERCHANT_SECRET=test_secret
PAYHERE_MODE=sandbox

# Storage - tests use mocks
STORAGE_MODE=local
STORAGE_CONNECTION_STRING=not_real
PRODUCT_IMAGE_CONTAINER=test-images
PRODUCT_IMAGE_MAX_BYTES=5242880
