{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test:chat:integration": "npm run build && node test/chat.integration.cjs",
    "email:test": "npm run build && node scripts/test-email.cjs",
    "email:preview": "npm run build && node scripts/preview-emails.cjs",
    "test:notifications": "npm test -- --runInBand src/notification",
    "test:notifications:integration": "npm run build && node test/notifications.integration.cjs",
    "test:ai": "npm test -- --runInBand src/ai",
    "test:ai:integration": "npm run build && node test/ai.integration.cjs",
    "test:experience:integration": "npm run build && node test/product-experience.integration.cjs",
    "seed:catalog": "npm run build && node scripts/seed-catalog.cjs",
    "seed:catalog:check": "npm run build && node scripts/seed-catalog.cjs --dry-run",
    "test:catalog:integration": "npm run build && node test/catalog.integration.cjs",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "test:auth:integration": "npm run build && node test/auth.integration.cjs",
    "seed:admin": "npm run build && node scripts/seed-admin.cjs",
    "test:admin:integration": "npm run build && node test/admin.integration.cjs",
    "test:cart:integration": "npm run build && node test/cart.integration.cjs",
    "test:checkout:integration": "npm run build && node test/checkout.integration.cjs",
    "test:orders:integration": "npm run build && node test/orders.integration.cjs",
    "test:payments:integration": "npm run build && node test/payments.integration.cjs",
    "test:repairs:integration": "npm run build && node test/repairs.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nest": "^0.1.6",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
